{
  "name": "easy-fill",
  "version": "0.1.0",
  "private": false,
  "description": "Privacy-first browser extension for Chinese application form autofill.",
  "license": "MIT",
  "keywords": [
    "browser-extension",
    "form-autofill",
    "chrome-extension",
    "edge-extension",
    "china",
    "internship",
    "graduate-school",
    "student-tools"
  ],
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run"
  },
  "dependencies": {
    "plasmo": "^0.90.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.269",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^24.1.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "manifest": {
    "name": "Easy Fill",
    "permissions": [
      "storage",
      "activeTab",
      "tabs"
    ],
    "host_permissions": [
      "<all_urls>"
    ]
  }
}
